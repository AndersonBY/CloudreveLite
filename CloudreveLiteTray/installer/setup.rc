#define IDI_APP 101

IDI_APP ICON "..\\assets\\cloud.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "FileDescription", "CloudreveLite 托盘分享工具安装程序"
            VALUE "ProductName", "CloudreveLite 托盘分享工具"
            VALUE "ProductVersion", "0.3.0"
            VALUE "FileVersion", "0.3.0"
            VALUE "OriginalFilename", "CloudreveLiteTray-Setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
